NODE_ENV=development
PORT=3000
REQUEST_LOG_DIR=logs

# Generate a random secret of at least 32 bytes in your untracked .env.local.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=nihongo-backend
JWT_AUDIENCE=nihongo-client

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nihongo
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000

SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=Nihongo API
SWAGGER_VERSION=1.0.0

# Optional: NestJS Observe credentials
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Direct CloudWatch logging. Enable after the log group and credentials are ready.
CLOUDWATCH_ENABLED=false
CLOUDWATCH_REGION=ap-southeast-1
# Replace with the exact name of your existing log group.
CLOUDWATCH_LOG_GROUP=/nihongo/backend/dev
CLOUDWATCH_LOG_STREAM=local-dev

# Local AWS credentials: fill only in your untracked .env.local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only when using temporary credentials.
AWS_SESSION_TOKEN=

# Alternative: use a configured AWS profile instead of the key fields above.
# AWS_PROFILE=nihongo-dev

# S3 storage: enable after an existing bucket and credentials are configured.
S3_ENABLED=false
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
# Leave endpoint empty for AWS S3; set it for R2/MinIO/other S3-compatible stores.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_TIMEOUT_MS=5000
# Optional dedicated S3 credentials. Otherwise use the AWS SDK credential chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE or an IAM role).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# SQS sender: queue aliases map to URLs of existing queues.
SQS_ENABLED=false
SQS_REGION=ap-southeast-1
SQS_TIMEOUT_MS=5000
SQS_QUEUE_URLS={"example":"https://sqs.ap-southeast-1.amazonaws.com/000000000000/example-queue"}

# Email: SMTP connects only when a feature explicitly sends a message.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Example Team <no-reply@example.com>"
SMTP_TIMEOUT_MS=15000
# Optional until auth integration; generate 32 random bytes encoded as 64 hex chars.
AUTH_EMAIL_VERIFICATION_KEY=
