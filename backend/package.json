{
  "name": "nest-typescript-starter",
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false",
    "build": "nest build",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1173.0",
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/client-sqs": "3.1176.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^1.0.0-rc.5",
    "handlebars": "4.7.10",
    "nodemailer": "10.6.1",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "^1.0.0-rc.5",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2",
    "vite": "8.2.4",
    "@nestjs/cli": {
      "minimatch": "11.0.1"
    },
    "@nestjs/mau": {
      "undici": "6.29.1"
    },
    "external-editor": {
      "tmp": "0.2.7"
    }
  }
}
